script/source = "extends Node2D

@export var player_character : player
@export var ia_character : ia
var curent_character 


var game_over : bool = false

func _ready() -> void:
	next_turn()

func next_turn ():
	if game_over:
		return
		
	if curent_character != null:
		curent_character.end_turn()
	
	if curent_character == ia_character or curent_character== null:
		curent_character = player_character
	else:
		curent_character = ia_character
	print(player_character)
	curent_character.start_turn()
	
	if curent_character.is_player:
		pass
		#definir ui
	else:
		#enlever ui 
		var wait_time =randf_range(0.5, 1.5)
		await get_tree().create_timer(wait_time).timeout
		 #action de combat
		await get_tree().create_timer(0.5).timeout
		next_turn()

func action_character_combat(action):
	if player !=curent_character:
		return
	player_character.action_character_combat(action, ia_character)
	#desactiver ui
	await get_tree().create_timer(0.5).timeout
	next_turn()

func ia_dicide_combat_action():
	pass

	
	
"

