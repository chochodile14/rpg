[sub_resource type="GDScript" id="GDScript_3ykye"]
script/source = "extends \"res://script/settings.gd\"

@export var audio_bus_name : String

var audio_bus_id

@onready var sfx_hover_player : AudioStreamPlayer = $SFX_Hover
@onready var sfx_click_player : AudioStreamPlayer = $SFX_Click
@onready var exit_btn         : Button             = $exit
@onready var particles_bg     : CPUParticles2D     = $BgParticles

func _ready() -> void:
	audio_bus_id = AudioServer.get_bus_index(audio_bus_name)
	_setup_particles()
	# Connexion directe des signaux — pas de [connection] dans le .tscn
	exit_btn.pressed.connect(_on_exit_pressed)
	exit_btn.mouse_entered.connect(_on_exit_hover)
	exit_btn.mouse_exited.connect(_on_exit_exit)

func _setup_particles() -> void:
	particles_bg.emitting              = true
	particles_bg.amount                = 80
	particles_bg.lifetime              = 6.0
	particles_bg.one_shot              = false
	particles_bg.explosiveness        = 1.0
	particles_bg.spread                = 180.0
	particles_bg.gravity               = Vector2(0, -25)
	particles_bg.initial_velocity_min  = 6.0
	particles_bg.initial_velocity_max  = 20.0
	particles_bg.scale_amount_min      = 1.0
	particles_bg.scale_amount_max      = 10.0
	particles_bg.color                 = Color(0.5, 0.35, 0.10, 0.5)
	particles_bg.color_ramp            = _ash_gradient()
	particles_bg.emission_shape        = CPUParticles2D.EMISSION_SHAPE_RECTANGLE
	particles_bg.emission_rect_extents = Vector2(600, 340)
	particles_bg.position              = Vector2(580, 340)

func _ash_gradient() -> Gradient:
	var g := Gradient.new()
	g.colors  = PackedColorArray([Color(0.7, 0.5, 0.15, 0.0),
								   Color(0.55, 0.38, 0.10, 0.55),
								   Color(0.12, 0.08, 0.03, 0.0)])
	g.offsets = PackedFloat32Array([0.0, 0.35, 1.0])
	return g

func _on_exit_hover() -> void:
	sfx_hover_player.play()
	var t := create_tween()
	t.tween_property(exit_btn, \"self_modulate\", Color(1.35, 1.1, 0.65, 1.0), 0.10)

func _on_exit_exit() -> void:
	var t := create_tween()
	t.tween_property(exit_btn, \"self_modulate\", Color(0.85, 0.72, 0.45, 1.0), 0.18)

func _on_music_control_value_changed(value: float) -> void:
	var db = linear_to_db(value)
	AudioServer.set_bus_volume_db(audio_bus_id, db)

func _on_exit_pressed() -> void:
	sfx_click_player.play()
	if from_pause:
		get_parent().show_main_buttons()
	else:
		get_tree().change_scene_to_file(\"res://hub.tscn\")
"

